.DS_Store
*/.DS_Store

__pycache__/
*.py[cod]

# Local runtime state can contain subscription URLs, node UUIDs, passwords,
# generated proxy configs, and request logs.
work/

# Build outputs and distributable archives are produced locally.
outputs/

# Swift compiler caches and temporary build tools.
.build/
DerivedData/

# Isolated Codex development worktrees.
.worktrees/

# Superpowers task briefs, review packages, and progress ledgers.
.superpowers/

# Generated iconset intermediates. The build script regenerates icons.
macos/ProxyBridgeMenuBar/AppIcon.iconset/

# Packaging artifacts
# 完整版（离线包）构建时下载的官方安装包：scripts/fetch_bundled_packages.py 的默认输出目录，
# 以及源码运行时可选的 bundled/ 离线包目录，均为体积较大的第三方二进制，不进入仓库。
bundled-packages/
/bundled/
outputs/windows/
outputs/linux/
desktop/**/__pycache__/
